{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:contract": "jest --selectProjects contract --runInBand",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "token:dev": "tsx scripts/token-dev.ts",
    "carga": "tsx scripts/carga.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "luxon": "^3.7.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@reservas/contracts": "*",
    "@types/jest": "^29.5.0",
    "@types/luxon": "^3.7.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "yaml": "^2.8.0"
  }
}
